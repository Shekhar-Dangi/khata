# Copy to .env and adjust. .env is gitignored — never commit real values.
DATABASE_URL=postgresql://USER@localhost:5432/finance
PORT=3000

# Which person column in a Splitwise export is yours (exact header text)
SPLITWISE_ME=

# Which local model answers /transactions/suggest, and the fallback for both jobs below.
# Empty means qwen3:4b. A reasoning-capable model must honour `think:false`: one that reasons
# anyway spends the whole output budget on it, and the answer is cut off and read as Unknown.
OLLAMA_MODEL=

# -- Reading receipts with a local model ----------------------------------------------------
# Every value below is a property of YOUR machine, not of the app. The defaults were measured
# on a 31.5 GB laptop with no GPU running gemma4:26b; a machine with a GPU can raise the window
# and cut the timeout. Leave a value empty to use its default.
#
# Which model reads invoices. Empty: OLLAMA_MODEL, then qwen3:4b.
RECEIPT_LLM_MODEL=
# Context window, in tokens (default 8192). It must FIT IN MEMORY: 16384 ran a 31.5 GB CPU-only
# machine out of memory with a 26B model. The document-size budget is derived from it.
RECEIPT_LLM_NUM_CTX=
# Most tokens the answer may use (default 2048; a 2-page invoice took ~450).
RECEIPT_LLM_NUM_PREDICT=
# How long one read may take, in ms (default 600000). ~4-5 minutes per invoice on a CPU.
RECEIPT_LLM_TIMEOUT_MS=
# true | false | low | medium | high | unset (default false, which measured better answers here).
# `unset` omits the field, for models whose API rejects it.
RECEIPT_LLM_THINK=
# 0 to 2 (default 0).
RECEIPT_LLM_TEMPERATURE=
# Keep the model loaded between documents, in Ollama's syntax: 30m, 1h, 300, -1 (forever).
RECEIPT_LLM_KEEP_ALIVE=
# Any other Ollama option, as a JSON object, e.g. {"num_thread": 8, "num_gpu": 0}.
RECEIPT_LLM_OPTIONS=
# How long docling may take to convert one PDF, in ms (default 120000).
RECEIPT_EXTRACT_TIMEOUT_MS=

# -- Suggesting categories with a local model (src/llm.ts) ---------------------------------
# Same variables as above with a CATEGORY_LLM_ prefix; empty means the default, which is exactly
# what this feature has always sent. Defaults: model OLLAMA_MODEL, NUM_PREDICT 40, TIMEOUT_MS
# 60000, THINK false, no window (Ollama's default).
#
# ONE MODEL FOR BOTH? Give both the SAME window. Ollama reloads a loaded model whenever a request
# asks for a different num_ctx — ~65s for a 26B model on a CPU — so a category suggestion made
# during a receipt batch would reload it twice. With RECEIPT_LLM_NUM_CTX=8192, set 8192 here too.
#
# Thinking on (CATEGORY_LLM_THINK=true) needs NUM_PREDICT raised: 40 tokens fits the answer and
# nowhere near a reasoning preamble, which would be cut off and read as Unknown.
CATEGORY_LLM_MODEL=
CATEGORY_LLM_NUM_CTX=
CATEGORY_LLM_NUM_PREDICT=
CATEGORY_LLM_TIMEOUT_MS=
CATEGORY_LLM_THINK=
CATEGORY_LLM_TEMPERATURE=
CATEGORY_LLM_KEEP_ALIVE=
CATEGORY_LLM_OPTIONS=
