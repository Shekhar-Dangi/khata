{
  "name": "finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd src && node --env-file=../.env --watch server.ts",
    "start": "node --env-file=.env src/server.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "start:demo": "node src/server.ts",
    "seed:demo": "node --env-file=.env scripts/seed-demo.ts",
    "build:api": "esbuild src/vercel-entry.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.js --external:pg --external:express",
    "build:vercel": "npm ci --prefix web && npm run build --prefix web",
    "demo:activity": "node scripts/demo-activity.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=24"
  }
}
